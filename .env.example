# ==============================================================================
# MANO HRM Mobile App - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the root of the project:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
# Production backend:
API_BASE_URL="https://attendance.mano.co.in/api"

# For local development with backend running on your PC (port 5001):
# When testing on a physical Android device over USB, run:
#   adb reverse tcp:5001 tcp:5001
# and set:
# API_BASE_URL="http://localhost:5001/api"
#
# If testing on Android Emulator:
# API_BASE_URL="http://10.0.2.2:5001/api"

# ------------------------------------------------------------------------------
# reCAPTCHA Configuration (Optional for Mobile)
# ------------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=""

# ------------------------------------------------------------------------------
# Direct Mail Service Credentials (for in-app bug report / admin mailing)
# ------------------------------------------------------------------------------
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"
ADMIN_EMAIL="admin1@example.com,admin2@example.com"

# ------------------------------------------------------------------------------
# Gmail OAuth2 Credentials (Optional / Backend use)
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER=""

# ------------------------------------------------------------------------------
# Firebase Web/App Configuration (Used by push notifications / FCM)
# Note: Android native FCM also uses `android/app/google-services.json`
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_VAPID_KEY=""
